# Environment Configuration for PlantCare AI

# Security
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Application Mode
FLASK_DEBUG=True
PORT=5000

# Database
DATABASE_PATH=instance/plantcare.db

# Uploads Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=8388608

# Machine Learning Model Path
MODEL_PATH=ml/models/plantcare_mobilenetv2.keras

# Optional Cloud Storage (Firebase)
FIREBASE_ENABLED=False
FIREBASE_CREDENTIALS=path/to/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
